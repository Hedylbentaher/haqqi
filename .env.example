# Copiez ce fichier sous le nom .env, puis collez votre clé.
# Le fichier .env n'est jamais envoyé sur GitHub (.gitignore).

# Modèle de langage : gemini (clé gratuite sur https://aistudio.google.com), groq, ou none
HAQQI_LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# HAQQI_LLM_MODEL=gemini-flash-latest

# Autre option gratuite : https://console.groq.com
# HAQQI_LLM_PROVIDER=groq
# GROQ_API_KEY=

# Modèle d'embeddings : e5 (multilingue, ~470 Mo téléchargés une fois) ou hash (test sans téléchargement)
HAQQI_EMBEDDER=e5
# HAQQI_EMBEDDING_MODEL=intfloat/multilingual-e5-small